# Required for AI features (translation, tailoring, evaluation extraction, cover letters).
# Without it the app still works using its built-in rule-based engine.
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI routes.
# ANTHROPIC_MODEL=claude-opus-5-5

# Public site URL, used for metadata / sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
